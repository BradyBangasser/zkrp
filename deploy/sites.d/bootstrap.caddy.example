# Serve this relay as one of the targets of the shared bootstrap name.
#
# Enable: copy to deploy/sites.d/bootstrap.caddy and set BOOTSTRAP_DOMAIN,
# CADDY_IMAGE (the zkrp-caddy image) and CLOUDFLARE_API_TOKEN (Zone:DNS:Edit
# for the zone) in .env. Every relay gets its own certificate through DNS-01, so it
# doesn't matter which relay Let's Encrypt's validators would have reached.
{$BOOTSTRAP_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	handle /healthz {
		reverse_proxy relay:9466
	}
	handle {
		reverse_proxy h2c://relay:9001
	}
}
