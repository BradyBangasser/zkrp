# Enrollment (compose.yml). Copy to auth.env (git-ignored). Secrets (token,
# issuer and nullifier keys) are files in the auth-secrets volume, made by
# `docker compose run --rm --no-deps auth keygen /secrets`, never here.

# The `auth` role's password must match AUTH_DB_PASSWORD in postgres.env.
DATABASE_URL=postgres://auth:<AUTH_DB_PASSWORD>@postgres/auth

# Who may enroll: email domains, comma-separated (subdomains included).
ALLOWED_EMAIL_DOMAINS=iastate.edu

# Magic links. MAILER=ses sends through SES from MAIL_FROM; MAILER=log only
# logs the link (development).
MAILER=ses
MAIL_FROM=
VERIFY_LINK_BASE=https://fratrat.app/verify

# App Attest: <TEAM ID>.<bundle id>, and production | development.
APP_ATTEST_APP_ID=WHN5849AD9.dev.bangasser.FratRat
APP_ATTEST_ENV=production

# AWS: SES for mail, and KMS for the nullifier pepper. On EC2 prefer an
# instance role and leave the keys empty.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Empty: use the local nullifier-key secret instead of KMS.
NULLIFIER_KMS_KEY_ID=

# Credential lifetime. Relays must use the same value.
EPOCH_SECS=2592000
RUST_LOG=info
