# zkrp-push (compose.yml). Secrets are files in the push-secrets volume, never
# variables here: push-key (from `push keygen`) and apns-key.p8.

# APNs token auth: the key's id and your Apple team id, and the app's bundle
# id. APNS=log logs alerts instead of sending them (development).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
#APNS=log

# What the alert says. Apps pass their own words; the default is generic.
PUSH_ALERT_TITLE=
PUSH_ALERT_BODY=New message

RUST_LOG=info
