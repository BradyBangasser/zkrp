# Caddy, TLS in front of the gRPC APIs. Copy to caddy.env: deploy/env/ on the
# core host, beside compose.yml on a relay host. The names are grey-cloud
# (DNS only) A/AAAA records at the host's IP.

# Which config (deploy/caddy/<role>.Caddyfile). Relay hosts: relay (the
# default) or relay-bootstrap. The core host must set it: core, or with a
# relay there (compose.relay.yml) core-relay or core-relay-bootstrap.
#CADDY_ROLE=core

# Core host: the enrollment API.
AUTH_DOMAIN=auth.example.net

# Relay host: this relay's API.
RELAY_DOMAIN=relay.example.net

# Relay that also answers for the shared bootstrap name (relay-bootstrap or
# core-relay-bootstrap): certificates through Cloudflare DNS-01, with a token
# limited to Zone → DNS → Edit on the zone.
#BOOTSTRAP_DOMAIN=bootstrap.zkrp.net
#CLOUDFLARE_API_TOKEN=
