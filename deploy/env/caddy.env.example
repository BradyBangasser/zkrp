# Caddy, TLS in front of the gRPC APIs. Copy to caddy.env: deploy/env/ on the
# core host, beside compose.yml on a relay host. The names are grey-cloud
# (DNS only) A/AAAA records at the host's IP.

# Core host: the enrollment API.
AUTH_DOMAIN=auth.example.net

# Relay host: this relay's API.
RELAY_DOMAIN=relay.example.net

# Relay host that also answers for the shared bootstrap name:
# certificates through Cloudflare DNS-01, with a token limited to
# Zone → DNS → Edit on the zone.
#CADDY_ROLE=relay-bootstrap
#BOOTSTRAP_DOMAIN=bootstrap.zkrp.net
#CLOUDFLARE_API_TOKEN=
