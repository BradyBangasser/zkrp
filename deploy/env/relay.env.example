# A relay (deploy/relay/compose.yml). Copy to relay.env beside that file.

# What clients dial for libp2p, without /p2p: usually
# /dns4/<RELAY_DOMAIN>/tcp/9000. Add /ip6/... if the host has public IPv6.
RELAY_PUBLIC_ADDRS=/dns4/relay.example.net/tcp/9000
# This relay's public gRPC URL (Caddy, caddy.env RELAY_DOMAIN).
PUBLIC_GRPC_URL=https://relay.example.net
REGION=eu-central
RELAY_MESHES=fratrat-v1

# From `keygen` on the core host. Relays verify credentials against it.
ISSUER_PUBLIC_KEY=
# Must match the core host's EPOCH_SECS.
EPOCH_SECS=2592000
# The enrollment URL handed to apps (https://<AUTH_DOMAIN>).
AUTH_URL=https://auth.example.net

# The shared relay registry on the core host, over a private network:
#   postgres://relay:<RELAY_DB_PASSWORD>@<core private IP>/registry
# Empty: this relay lists only itself.
DATABASE_URL=

# Push (optional; both or neither). The core's push service over the private
# network (http://push:9003 for a relay on the core host), and the key from
# `push keygen` that apps seal their tokens to. Registrations live under push/
# in the mailbox bucket: give push/ the same 8-day lifecycle rule as mb/.
#PUSH_URL=http://<core private IP>:9003
#PUSH_PUBLIC_KEY=

# S3 for blobs, mailboxes and debug logs. On EC2 prefer an instance role and
# leave the keys empty.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BLOB_BUCKET=
LOG_BUCKET=
CF_DOMAIN=
# Held store-and-forward messages, under mb/. Defaults to BLOB_BUCKET. Give
# mb/ a lifecycle rule that expires objects after 8 days.
#MAILBOX_BUCKET=

RUST_LOG=info
