# Caddy with the Cloudflare DNS plugin, for DNS-01 certificates. Needed when
# several relays serve one shared name (bootstrap.zkrp.net): Let's Encrypt's
# HTTP/TLS challenges would land on whichever relay DNS picks, so only DNS-01
# works for all of them.
FROM docker.io/library/caddy:2.10-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM docker.io/library/caddy:2.10
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
