# Copy to .env and fill in. Never commit .env or ./secrets.

# Postgres (compose creates the auth and registry databases on first start)
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
RELAY_DB_PASSWORD=

# AWS: S3 for blobs/mailboxes/logs, SES for magic links, KMS for nullifiers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
BLOB_BUCKET=
LOG_BUCKET=
CF_DOMAIN=

# Public names for TLS (Caddy gets certificates for these)
RELAY_DOMAIN=relay.localhost
AUTH_DOMAIN=auth.localhost
# Optional shared name answered by every relay (see docs/deployment.md). Needs
# CADDY_IMAGE=ghcr.io/bradybangasser/zkrp-caddy and a Cloudflare token with
# Zone:DNS:Edit, plus deploy/sites.d/bootstrap.caddy.
BOOTSTRAP_DOMAIN=
CADDY_IMAGE=docker.io/library/caddy:2.10
CLOUDFLARE_API_TOKEN=

# Relay
RELAY_PUBLIC_ADDRS=/ip4/127.0.0.1/tcp/9000
REGION=local
RELAY_MESHES=fratrat-v1
# Printed by `zkrp-auth keygen`; also in ./secrets/issuer-public-key
ISSUER_PUBLIC_KEY=

# Auth
ALLOWED_EMAIL_DOMAINS=iastate.edu
# ses | log (log prints the magic link instead of sending it; dev only)
MAILER=ses
MAIL_FROM=
VERIFY_LINK_BASE=https://fratrat.app/verify
# <TEAM ID>.<bundle id>
APP_ATTEST_APP_ID=
# production | development
APP_ATTEST_ENV=production
# Leave empty to use ./secrets/nullifier-key instead of KMS
NULLIFIER_KMS_KEY_ID=
# Credential lifetime. Relays and auth must agree.
EPOCH_SECS=2592000
