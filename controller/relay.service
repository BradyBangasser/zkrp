[Unit]
Description=ZKRP Relay
After=network-online.target
Wants=network-online.target

# Host-specific settings live in /etc/system.env, e.g.
#   RELAY_PUBLIC_ADDRS=/dns4/relay.a.central.us.infra.zkrp.net/tcp/9000
#   REGION=us-central
#   RELAY_MESHES=fratrat-v1
#   ISSUER_PUBLIC_KEY=<hex from zkrp-auth keygen>
#   RELAY_DOMAIN=relay.a.central.us.infra.zkrp.net   (TLS via caddy.service)
#   AWS_REGION=us-east-2
#   BLOB_BUCKET=fratrat
#   LOG_BUCKET=fratrat-logs
#   CF_DOMAIN=blobfront.infra.zkrp.net
#   IMAGE=ghcr.io/bradybangasser/zkrp-relay
#   IMAGE_TAG=latest          (pin a release tag in production)
#   AUTH_URL=https://auth.infra.zkrp.net     (served to apps)

[Service]
Type=exec
TimeoutStartSec=300
EnvironmentFile=/etc/system.env
ExecStartPre=-/usr/bin/podman rm -f zkrp-relay
ExecStartPre=/usr/bin/podman pull ${IMAGE}:${IMAGE_TAG}
ExecStart=/usr/bin/podman run \
    --rm \
    --name zkrp-relay \
    --network host \
    --volume /var/lib/zkrp:/data:Z \
    --volume /run/credentials/relay.service:/run/credentials:ro \
    --env CREDENTIALS_DIRECTORY=/run/credentials \
    --env IDENTITY_PATH=/data/relay_identity.key \
    --env METRICS_ADDR=127.0.0.1:9464 \
    --env GRPC_BIND=127.0.0.1 \
    --env HEALTH_ADDR=127.0.0.1:9466 \
    --env-file /etc/system.env \
    --health-cmd "/usr/local/bin/zkrp-relay healthcheck" \
    --health-interval 30s \
    --health-on-failure kill \
    ${IMAGE}:${IMAGE_TAG}
ExecStop=/usr/bin/podman stop --time 15 zkrp-relay
LoadCredentialEncrypted=aws-key-id:/etc/zkrp/credentials/aws-key-id.cred
LoadCredentialEncrypted=aws-secret:/etc/zkrp/credentials/aws-secret.cred
# Optional shared relay registry. To enable, create the credential with
#   printf '%s' 'postgres://relay:...@core-host/registry' \
#     | systemd-creds encrypt --name=database-url - /etc/zkrp/credentials/database-url.cred
# and uncomment:
#LoadCredentialEncrypted=database-url:/etc/zkrp/credentials/database-url.cred
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
