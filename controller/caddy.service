[Unit]
Description=TLS proxy for the ZKRP relay's gRPC API
After=network-online.target relay.service
Wants=network-online.target

# Needs RELAY_DOMAIN in /etc/system.env, pointing at this host, with ports 80
# and 443 open for certificate issuance.
#
# To also serve the shared bootstrap name (BOOTSTRAP_DOMAIN), put
# bootstrap.caddy in /etc/zkrp/caddy.d, set CADDY_IMAGE to the zkrp-caddy
# image, and add a Cloudflare API token (Zone:DNS:Edit) as a credential:
#   printf '%s' "$TOKEN" | systemd-creds encrypt --name=cloudflare-token - \
#     /etc/zkrp/credentials/cloudflare-token.cred
# then uncomment the LoadCredentialEncrypted line below.

[Service]
Type=exec
EnvironmentFile=/etc/system.env
ExecStartPre=-/usr/bin/podman rm -f zkrp-caddy
# The token is read from the systemd credential, never from the env file.
# ($$ passes a literal $ through to sh; systemd would expand $VAR itself.)
ExecStart=/bin/sh -c 'export CLOUDFLARE_API_TOKEN="$$(cat "$${CREDENTIALS_DIRECTORY}/cloudflare-token" 2>/dev/null)"; \
    exec /usr/bin/podman run \
    --rm \
    --name zkrp-caddy \
    --network host \
    --volume /opt/zkrp/repo/controller/Caddyfile:/etc/caddy/Caddyfile:ro,Z \
    --volume /etc/zkrp/caddy.d:/etc/caddy/sites.d:ro,Z \
    --volume /var/lib/zkrp-caddy:/data:Z \
    --env RELAY_DOMAIN \
    --env BOOTSTRAP_DOMAIN \
    --env CLOUDFLARE_API_TOKEN \
    "$${CADDY_IMAGE}"'
ExecStop=/usr/bin/podman stop --time 15 zkrp-caddy
#LoadCredentialEncrypted=cloudflare-token:/etc/zkrp/credentials/cloudflare-token.cred
NoNewPrivileges=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
